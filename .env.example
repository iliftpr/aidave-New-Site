# =============================================
# Dave's AI Agent (floating chat widget)
# =============================================
# Used by: app/api/chat/route.ts, app/api/voice/agent-url/route.ts,
# app/api/receptionist-demo/route.ts (the "Never Miss a Call" live demo),
# and the client widget at components/dave-agent/*.

# Required: Claude powers the text chat (Opus 4.7) and the receptionist demo (Haiku 4.5).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Required for voice mode: ElevenLabs Conversational AI.
# Server-side key — never expose to the client.
ELEVENLABS_API_KEY=sk_...

# Required for voice mode: ElevenLabs Convai agent ID.
# Configured in the ElevenLabs dashboard. The agent's system prompt,
# voice, and LLM all live there.
ELEVENLABS_AGENT_ID=EST9Ui6982FZPSi7gCHi

# Public: where the in-chat "Schedule a Discovery Call" button books to.
# Defaults to the free 30-min Automation Audit if not set.
NEXT_PUBLIC_DISCOVERY_CALL_URL=https://cal.com/ilift/automation-audit

# =============================================
# Existing site env vars (unrelated to Dave's AI)
# =============================================
RESEND_API_KEY=re_...
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PRICE_ID=price_...

# =============================================
# Tracking pixels (components/analytics/*)
# =============================================
# Each pixel renders nothing until its id is set — safe to leave blank locally.
# Meta Pixel id from Events Manager
NEXT_PUBLIC_META_PIXEL_ID=
# LinkedIn Insight Tag partner id from Campaign Manager
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# Optional: LinkedIn conversion id for Lead events
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=
